# Copy to .env and paste your own key. .env is git-ignored. Never commit a key.
SERPAPI_API_KEY=

# Development safety rails (see docs/search-budget.md)
# Searches that must stay untouched on the account at all times.
SERPAPI_RESERVE=100

# Keepa (Amazon price and catalogue for v2). See docs/superpowers/plans/2026-11-22-keepa-agent-discovery-tracking.md
KEEPA_API_KEY=
# Tokens that must stay on the account after any dev spend (applied once balance is known from Keepa).
KEEPA_RESERVE=5
