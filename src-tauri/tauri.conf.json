{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Split Finder",
  "version": "0.1.0",
  "identifier": "com.bundlesplitfinder.desktop",
  "build": {
    "frontendDist": "../desktop/dist",
    "devUrl": "http://127.0.0.1:8790",
    "beforeDevCommand": "npm run desktop:bundle-agent",
    "beforeBuildCommand": "npm run package && node desktop/stage-dist.mjs && npm run desktop:bundle-agent"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Split Finder Agent",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "http://127.0.0.1:8790"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/agent-dashboard"],
    "resources": {
      "../desktop/dist/*-chrome.zip": ".",
      "../desktop/dist/ui/": "ui"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
