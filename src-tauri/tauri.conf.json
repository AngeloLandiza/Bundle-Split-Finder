{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Split Finder",
  "version": "0.1.0",
  "identifier": "com.bundlesplitfinder.desktop",
  "build": {
    "frontendDist": "../desktop/dist",
    "devUrl": "http://127.0.0.1:8790",
    "beforeDevCommand": "npm run desktop:bundle-agent",
    "beforeBuildCommand": "npm run package && node desktop/stage-dist.mjs && npm run desktop:bundle-agent"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Split Finder",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "create": false,
        "url": "http://127.0.0.1:8790/ui/"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:8790 ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    },
    "withGlobalTauri": false,
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/AngeloLandiza/Bundle-Split-Finder/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2MTc3MUNEMkIwQUE4OUMKUldTY3FBb3J6WEVYSmwwYTZ0NkFtMzdCQmdEallnKytHd3hvMGxTYWIzbkVOaHBhQ3NCM1o2K1YK",
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/agent-dashboard"],
    "resources": {
      "../desktop/dist/*-chrome.zip": ".",
      "../desktop/dist/ui/": "ui"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
