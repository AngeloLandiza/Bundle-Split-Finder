{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Split Finder desktop shell (Rust side and local content)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:allow-spawn",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "agent-dashboard",
          "sidecar": true
        }
      ]
    },
    "notification:default",
    "autostart:default",
    "window-state:default"
  ]
}
