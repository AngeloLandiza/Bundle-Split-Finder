{
  "name": "bundle-split-finder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run && vitest run --config vitest.ext.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension && tsc --noEmit -p e2e",
    "ext:dev": "wxt",
    "ext:build": "wxt build",
    "postinstall": "wxt prepare",
    "budget": "tsx scripts/budget.ts",
    "scan": "tsx scripts/scan.ts",
    "validate": "tsx scripts/validate.ts",
    "ebay:record": "tsx scripts/ebay-record.ts",
    "keepa:record": "tsx scripts/keepa-record.ts",
    "keepa:measure": "tsx scripts/keepa-measure.ts",
    "keepa:budget": "tsx scripts/keepa-budget.ts",
    "agent:scan": "tsx agent/run.ts",
    "relay:dev": "tsx scripts/relay-dev.ts",
    "agent:dashboard": "tsx agent/server.ts",
    "judge:eval": "tsx scripts/judge-eval.ts",
    "assist:eval": "tsx scripts/assist-eval.ts",
    "research:eval": "tsx scripts/research-eval.ts",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "package": "tsx scripts/package.ts",
    "vm:bundle": "tsx scripts/vm-bundle.ts",
    "desktop:build-ui": "vite build --config desktop-ui/vite.config.ts",
    "desktop:bundle-agent": "tsx desktop/bundle-agent.ts",
    "desktop:dev": "npm run desktop:bundle-agent && tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:windows": "tauri build",
    "test:e2e": "SPLIT_FINDER_E2E=1 wxt build && SPLIT_FINDER_E2E=1 playwright test",
    "audit": "tsx scripts/audit.ts"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
